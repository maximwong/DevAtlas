{
  "name": "devatlas",
  "version": "0.4.0",
  "private": true,
  "description": "个人技术成长工作空间",
  "author": "DevAtlas contributors",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "node scripts/build-automation.mjs && concurrently -k \"vite --host 127.0.0.1\" \"wait-on http://127.0.0.1:5173 && electron .\"",
    "dev:web": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "test": "node scripts/build-automation.mjs && vitest run",
    "build": "npm run typecheck && vite build && node scripts/build-automation.mjs",
    "dist:win": "npm run build && electron-builder --win --x64",
    "api:tools": "node scripts/devatlas-cli.cjs tools"
  },
  "build": {
    "appId": "org.devatlas.desktop",
    "productName": "DevAtlas",
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "directories": {
      "output": "release"
    }
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@xyflow/react": "^12.12.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "electron": "^45.1.0",
    "electron-builder": "^26.18.0",
    "jsdom": "^30.1.3",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "wait-on": "^9.5.1",
    "rolldown": "1.2.15"
  },
  "type": "module"
}
